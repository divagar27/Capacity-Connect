PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capacity_connect?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiry
JWT_SECRET=replace-with-a-random-development-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/callback

# Bootstrap Admin Emails (comma separated)
ADMIN_EMAILS=

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=capacity-connect-media
CERTIFICATE_ISSUER=Capacity Connect demonstration

# Antivirus & Workers
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
ENABLE_VIRUS_SCAN=false
